# Required
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678
# Either form works; port 27262 is your Palworld REST API port.
PALWORLD_API_URL=http://YOUR_SERVER_HOST:27262/v1/api
# Leave empty only if your Palworld REST API is configured without authentication.
PALWORLD_API_PASSWORD=your_palworld_admin_password

# Optional (defaults shown)
UPDATE_INTERVAL=120
# The bot creates/reuses one marked embed if this is blank.
STATUS_MESSAGE_ID=
# Keep this unchanged unless you intentionally want a separate status embed.
STATUS_EMBED_MARKER=palworld-status-bot:v1
LOG_LEVEL=INFO
